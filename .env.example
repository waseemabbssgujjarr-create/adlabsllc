# Email delivery for the contact form (https://resend.com)
# 1. Create a free Resend account
# 2. Create an API key and paste it below
RESEND_API_KEY=

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=hello@aderalabs.com

# Sender address. Until aderalabs.com's domain is verified in Resend,
# leave this as the Resend sandbox sender below — it works immediately.
# Once your domain is verified, change it to e.g. notifications@aderalabs.com
CONTACT_FROM_EMAIL=AdEra Labs Website <onboarding@resend.dev>
